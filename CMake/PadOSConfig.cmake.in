@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(xkbcommon 1.13 CONFIG)
find_dependency(ZLIB)
find_dependency(freetype 2.15 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/PadOSTargets.cmake")

# Export the lists as variables:
set(PADOS_KERNEL_MODULE_TARGETS "@PADOS_KERNEL_MODULE_EXT_TARGETS@")
set(PADOS_KERNEL_LIBRARY_TARGETS "@PADOS_KERNEL_LIBRARY_EXT_TARGETS@")
